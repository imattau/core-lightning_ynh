#!/bin/bash

source "$(dirname "$0")/_common.sh"
source /usr/share/yunohost/helpers

ynh_abort_if_errors

getter__alias() {
	ynh_cln_setting alias "My YunoHost Lightning Node"
}

setter__alias() {
	ynh_app_setting_set --app="$app" --key=alias --value="$alias"
	ynh_cln_require_bitcoin_app
	ynh_cln_read_bitcoin_rpc_credentials
	ynh_cln_write_config
	ynh_cln_restart_and_check alias
}

getter__p2p() {
	ynh_cln_p2p_port
}

setter__p2p() {
	case "$p2p" in
		''|*[!0-9]*) ynh_die "Lightning P2P port must be numeric" ;;
	esac
	[ "$p2p" -ge 1 ] && [ "$p2p" -le 65535 ] || ynh_die "Lightning P2P port must be between 1 and 65535"
	ynh_app_setting_set --app="$app" --key=p2p --value="$p2p"
	ynh_cln_require_bitcoin_app
	ynh_cln_read_bitcoin_rpc_credentials
	ynh_cln_write_config
	ynh_cln_restart_and_check p2p
}

getter__log_level() {
	ynh_cln_setting log_level info
}

setter__log_level() {
	case "$log_level" in
		info|debug|io) ;;
		*) ynh_die "Unsupported Core Lightning log level: $log_level" ;;
	esac
	ynh_app_setting_set --app="$app" --key=log_level --value="$log_level"
	ynh_cln_require_bitcoin_app
	ynh_cln_read_bitcoin_rpc_credentials
	ynh_cln_write_config
	ynh_cln_restart_and_check log_level
}

getter__announce_addr() { ynh_cln_setting announce_addr ''; }

setter__announce_addr() {
	case "$announce_addr" in *[[:space:]]*) ynh_die "Announce address must not contain whitespace" ;; esac
	ynh_app_setting_set --app="$app" --key=announce_addr --value="$announce_addr"
	ynh_cln_require_bitcoin_app; ynh_cln_read_bitcoin_rpc_credentials; ynh_cln_write_config
	ynh_cln_restart_and_check announce_addr
}

getter__rgb() { ynh_cln_setting rgb ''; }

setter__rgb() {
	if [ -n "$rgb" ] && { [ "${#rgb}" -ne 6 ] || case "$rgb" in *[!0-9A-Fa-f]*) true ;; *) false ;; esac; }; then
		ynh_die "Node color must be exactly six hexadecimal characters"
	fi
	ynh_app_setting_set --app="$app" --key=rgb --value="$rgb"
	ynh_cln_require_bitcoin_app; ynh_cln_read_bitcoin_rpc_credentials; ynh_cln_write_config
	ynh_cln_restart_and_check rgb
}

getter__fee_base() { ynh_cln_setting fee_base 1000; }
getter__fee_per_sat() { ynh_cln_setting fee_per_sat 10; }
getter__min_capacity_sat() { ynh_cln_setting min_capacity_sat 10000; }
getter__min_emergency_sat() { ynh_cln_setting min_emergency_sat 25000; }

setter__fee_base() {
	case "$fee_base" in ''|*[!0-9]*) ynh_die "Base fee must be a non-negative integer" ;; esac
	ynh_app_setting_set --app="$app" --key=fee_base --value="$fee_base"
	ynh_cln_require_bitcoin_app; ynh_cln_read_bitcoin_rpc_credentials; ynh_cln_write_config
	ynh_cln_restart_and_check fee_base
}

setter__fee_per_sat() {
	case "$fee_per_sat" in ''|*[!0-9]*) ynh_die "Proportional fee must be a non-negative integer" ;; esac
	ynh_app_setting_set --app="$app" --key=fee_per_sat --value="$fee_per_sat"
	ynh_cln_require_bitcoin_app; ynh_cln_read_bitcoin_rpc_credentials; ynh_cln_write_config
	ynh_cln_restart_and_check fee_per_sat
}

setter__min_capacity_sat() {
	case "$min_capacity_sat" in ''|*[!0-9]*) ynh_die "Minimum channel capacity must be a non-negative integer" ;; esac
	ynh_app_setting_set --app="$app" --key=min_capacity_sat --value="$min_capacity_sat"
	ynh_cln_require_bitcoin_app; ynh_cln_read_bitcoin_rpc_credentials; ynh_cln_write_config
	ynh_cln_restart_and_check min_capacity_sat
}

setter__min_emergency_sat() {
	case "$min_emergency_sat" in ''|*[!0-9]*) ynh_die "Emergency reserve must be a non-negative integer" ;; esac
	[ "$min_emergency_sat" -le 2100000000 ] || ynh_die "Emergency reserve must be no more than 2100000000 satoshis"
	ynh_app_setting_set --app="$app" --key=min_emergency_sat --value="$min_emergency_sat"
	ynh_cln_require_bitcoin_app; ynh_cln_read_bitcoin_rpc_credentials; ynh_cln_write_config
	ynh_cln_restart_and_check min_emergency_sat
}

ynh_cln_peer_choices() {
	local nodes
	nodes="$(ynh_cln_rpc listnodes 2>/dev/null)" || {
		printf '%s\n' '[]'
		return 0
	}
	printf '%s' "$nodes" | jq -c '
		[.nodes[]?
		 | select((.nodeid // "") | test("^[0-9A-Fa-f]{66}$"))
		 | select((.addresses // []) | length > 0)
		 | {key: .nodeid, timestamp: (.last_timestamp // 0),
		    value: ((.alias // "Unnamed peer") + " — " +
		      ((.addresses // [])
		       | map((.type // "address") + ":" + (.address // "?") + ":" + ((.port // 0) | tostring))
		       | join(", ")))}]
		| sort_by(.timestamp)
		| reverse
		| .[0:50]
		| map({key: .key, value: .value})
		| from_entries' 2>/dev/null || printf '%s\n' '[]'
}

getter__peer_discovery_status() {
	local count
	if ! ynh_cln_healthcheck >/dev/null 2>&1; then
		cat <<'EOF'
style: warning
ask:
  en: Peer discovery is unavailable while Core Lightning RPC is offline. You can still use manual peer mode.
  fr: La découverte des pairs est indisponible lorsque le RPC de Core Lightning est hors ligne. Vous pouvez utiliser le mode manuel.
EOF
		return 0
	fi
	count="$(ynh_cln_peer_choices | jq 'length' 2>/dev/null || echo 0)"
	if [ "$count" -gt 0 ]; then
		printf 'style: info\nask:\n  en: "%s public peers discovered. Select one below; CLN will resolve its address through gossip or DNS."\n  fr: "%s pairs publics découverts. Sélectionnez-en un; CLN résoudra son adresse via le gossip ou le DNS."\n' "$count" "$count"
	else
		cat <<'EOF'
style: warning
ask:
  en: No public peers with advertised addresses were discovered. Use manual peer mode or connect a bootstrap peer first.
  fr: Aucun pair public avec une adresse annoncée n'a été découvert. Utilisez le mode manuel ou connectez d'abord un pair d'amorçage.
EOF
	fi
}

getter__peer_id() {
	local choices
	choices="$(ynh_cln_peer_choices)"
	printf 'choices: %s\n' "$choices"
}

ynh_cln_select_peer() {
	case "$peer_mode" in
		discovered)
			peer_host=''
			peer_port=''
			;;
		manual)
			peer_id="$manual_peer_id"
			peer_host="$manual_peer_host"
			peer_port="$manual_peer_port"
			;;
		*) ynh_die "Choose discovered or manual peer selection" ;;
	esac
}

ynh_cln_validate_channel_inputs() {
	case "$peer_id" in
		''|*[!0-9A-Fa-f]*) ynh_die "Peer node ID must be 66 hexadecimal characters" ;;
	esac
	[ "${#peer_id}" -eq 66 ] || ynh_die "Peer node ID must be 66 hexadecimal characters"

	if [ "$peer_mode" = "manual" ]; then
		[ -n "$peer_host" ] || ynh_die "Peer host or IP address is required in manual peer mode"
		case "$peer_host" in
			*[[:space:]]*) ynh_die "Peer host or IP address must not contain whitespace" ;;
		esac
	fi

	if [ "$peer_mode" = "manual" ]; then
		case "$peer_port" in
			''|*[!0-9]*) ynh_die "Peer P2P port must be numeric" ;;
		esac
		[ "$peer_port" -ge 1 ] && [ "$peer_port" -le 65535 ] || ynh_die "Peer P2P port must be between 1 and 65535"
	fi
}

ynh_cln_normalize_channel_options() {
	case "$public_channel" in
		true|1) public_channel=true ;;
		false|0|'') public_channel=false ;;
		*) ynh_die "Public channel must be true or false" ;;
	esac
}

ynh_cln_validate_channel_amount() {
	case "$channel_amount_sat" in
		''|*[!0-9]*) ynh_die "Channel amount must be a positive integer in satoshis" ;;
	esac
	[ "$channel_amount_sat" -ge 546 ] || ynh_die "Channel amount must be at least 546 satoshis"
	[ "$channel_amount_sat" -le 16777215 ] || ynh_die "Channel amount exceeds the standard channel limit"
}

ynh_cln_peer_is_connected() {
	local peers
	peers="$(ynh_cln_rpc listpeers "$peer_id" 2>/dev/null || true)"
	printf '%s' "$peers" | jq -e --arg peer "$peer_id" 'any(.peers[]?; .id == $peer and .connected == true)' >/dev/null 2>&1
}

ynh_cln_available_confirmed_sat() {
	local funds available
	funds="$(ynh_cln_rpc listfunds 2>/dev/null)" || ynh_die "Could not read the Core Lightning wallet balance."
	available="$(printf '%s' "$funds" | jq -er '[.outputs[]? | select(.status == "confirmed" and (.reserved // false) == false) | (.amount_msat // 0)] | add // 0 | floor / 1000 | floor' 2>/dev/null)" || ynh_die "Core Lightning returned an unreadable wallet balance."
	printf '%s' "$available"
}

ynh_cln_print_channel_result() {
	local result summary
	result="$1"
	if summary="$(printf '%s' "$result" | jq -er '"Funding transaction: " + (.txid // "pending") + "; channel ID: " + (.channel_id // "pending") + "; output: " + ((.outnum // "pending")|tostring)' 2>/dev/null)"; then
		ynh_print_info "$summary"
	else
		ynh_print_info "$result"
	fi
}

run__connect_peer() {
	local result
	ynh_cln_select_peer
	ynh_cln_validate_channel_inputs
	if ynh_cln_peer_is_connected; then
		ynh_print_info "Peer $peer_id is already connected."
		return 0
	fi
	if [ "$peer_mode" = "discovered" ]; then
		if ! result="$(ynh_cln_rpc connect "$peer_id" 2>&1)"; then
			ynh_die "Core Lightning could not resolve or connect to discovered peer $peer_id: $result"
		fi
		ynh_print_info "Connected to discovered peer $peer_id using gossip/DNS address resolution."
		return 0
	fi
	if ! result="$(ynh_cln_rpc connect "$peer_id" "$peer_host" "$peer_port" 2>&1)"; then
		ynh_die "Core Lightning could not connect to peer $peer_id at $peer_host:$peer_port: $result"
	fi
	ynh_print_info "Connected to peer $peer_id at $peer_host:$peer_port."
}

run__generate_deposit_address() {
	local result address
	ynh_cln_healthcheck >/dev/null 2>&1 || ynh_die "Core Lightning RPC is unavailable."
	if ! result="$(ynh_cln_rpc newaddr bech32 2>&1)"; then
		ynh_die "Core Lightning could not generate a deposit address: $result"
	fi
	address="$(printf '%s' "$result" | jq -er '.bech32' 2>/dev/null)" || ynh_die "Core Lightning returned an unreadable deposit address."
	ynh_app_setting_set --app="$app" --key=deposit_address --value="$address"
	ynh_print_info "Send on-chain Bitcoin to this Core Lightning deposit address: $address"
	ynh_print_info "Wait for the transaction to confirm, then use Open channel in this panel. This address and its funds belong to Core Lightning, not an embedded Alby Hub wallet."
}

run__open_channel() {
	local result available
	ynh_cln_select_peer
	ynh_cln_validate_channel_inputs
	ynh_cln_validate_channel_amount
	ynh_cln_normalize_channel_options
	case "$confirm_channel_open" in
		true|1) ;;
		*) ynh_die "Tick the confirmation box before opening a channel. This action spends Core Lightning wallet funds." ;;
	esac
	ynh_cln_healthcheck >/dev/null 2>&1 || ynh_die "Core Lightning RPC is unavailable."
	ynh_cln_peer_is_connected || ynh_die "Peer $peer_id is not connected. Connect to the peer first."
	available="$(ynh_cln_available_confirmed_sat)"
	[ "$available" -gt "$channel_amount_sat" ] || ynh_die "The CLN wallet has $available confirmed spendable satoshis, but opening this channel requires $channel_amount_sat plus fees."
	if ! result="$(ynh_cln_rpc fundchannel "$peer_id" "$channel_amount_sat" normal "$public_channel" 2>&1)"; then
		ynh_die "Core Lightning could not open the channel: $result"
	fi
	ynh_print_info "Channel request accepted for peer $peer_id: $channel_amount_sat satoshis, public=$public_channel. It becomes usable after the funding transaction confirms."
	ynh_cln_print_channel_result "$result"
}

run__show_channels() {
	local result summary
	ynh_cln_healthcheck >/dev/null 2>&1 || ynh_die "Core Lightning RPC is unavailable."
	result="$(ynh_cln_rpc listfunds 2>&1)" || ynh_die "Could not read Core Lightning channels: $result"
	if summary="$(printf '%s' "$result" | jq -er '[.channels[]? | "peer=" + (.peer_id // "unknown") + "; state=" + (.state // "unknown") + "; connected=" + ((.connected // false)|tostring) + "; local_msat=" + ((.our_amount_msat // 0)|tostring) + "; capacity_msat=" + ((.amount_msat // 0)|tostring)] | if length == 0 then "No channels found." else join("\n") end' 2>/dev/null)"; then
		ynh_print_info "$summary"
	else
		ynh_print_info "$result"
	fi
}

ynh_cln_recovery_secret() {
	local hsmtool="$install_dir/bin/lightning-hsmtool" mnemonic
	local hsm_secret="$data_dir/bitcoin/hsm_secret"
	[ -x "$hsmtool" ] || hsmtool="$install_dir/tools/lightning-hsmtool"
	[ -x "$hsmtool" ] || return 1
	[ -r "$hsm_secret" ] || return 2
	mnemonic="$("$hsmtool" getsecret "$hsm_secret" 2>/dev/null)" || return 3
	[ -n "$mnemonic" ] || return 3
	printf '%s' "$mnemonic"
}

getter__recovery_mnemonic() {
	local mnemonic
	if mnemonic="$(ynh_cln_recovery_secret 2>/dev/null)"; then
		printf '%s' "$mnemonic"
	else
		printf '%s' 'Recovery phrase is unavailable. Check that the node completed its first startup and that its hsm_secret is readable.'
	fi
}

getter__grpc_enabled() {
	ynh_cln_setting grpc_enabled false
}

setter__grpc_enabled() {
	# YunoHost's config-panel boolean type passes its own yes/no encoding
	# (1/0) to the setter, not the literal strings "true"/"false" - accept
	# both so this works whether called via the panel or directly.
	case "$grpc_enabled" in
		true|1) grpc_enabled=true ;;
		false|0) grpc_enabled=false ;;
		*) ynh_die "grpc_enabled must be true or false" ;;
	esac
	ynh_app_setting_set --app="$app" --key=grpc_enabled --value="$grpc_enabled"
	ynh_cln_require_bitcoin_app
	ynh_cln_read_bitcoin_rpc_credentials
	ynh_cln_write_config
	ynh_cln_restart_and_check grpc_enabled
}

getter__grpc_port() {
	ynh_cln_grpc_port
}

setter__grpc_port() {
	case "$grpc_port" in
		''|*[!0-9]*) ynh_die "gRPC port must be numeric" ;;
	esac
	[ "$grpc_port" -ge 1 ] && [ "$grpc_port" -le 65535 ] || ynh_die "gRPC port must be between 1 and 65535"
	ynh_app_setting_set --app="$app" --key=grpc_port --value="$grpc_port"
	ynh_cln_require_bitcoin_app
	ynh_cln_read_bitcoin_rpc_credentials
	ynh_cln_write_config
	ynh_cln_restart_and_check grpc_port
}

getter__status() {
	local info summary channels outputs bitcoin_status grpc_status backup_status candidate found=""
	# This is a read-only display value.  Nothing in it may abort the whole
	# config-panel read when the node or Bitcoin backend is temporarily
	# unavailable.
	if ynh_cln_healthcheck >/dev/null 2>&1; then
		info="$(ynh_cln_rpc getinfo 2>/dev/null || true)"
		channels="$(ynh_cln_rpc listfunds 2>/dev/null | jq -r '.channels | length' 2>/dev/null || echo '?')"
		outputs="$(ynh_cln_rpc listfunds 2>/dev/null | jq -r '.outputs | length' 2>/dev/null || echo '?')"
		if [ -n "$bitcoin_install_dir" ]; then
			for candidate in "$bitcoin_install_dir"/bitcoin-*/bin/bitcoin-cli; do
				[ -x "$candidate" ] || continue
				if [ -n "$found" ]; then found=""; break; fi
				found="$candidate"
			done
		fi
		if [ -n "$found" ] && runuser -u "$app" -- "$found" -conf="$bitcoin_config_file" -datadir="$bitcoin_data_dir" getblockchaininfo >/dev/null 2>&1; then bitcoin_status="Bitcoin RPC OK"; else bitcoin_status="Bitcoin RPC unavailable"; fi
		if [ "$(ynh_cln_setting grpc_enabled false)" = "true" ] && [ -r "$data_dir/bitcoin/ca.pem" ] && [ -r "$data_dir/bitcoin/client.pem" ] && [ -r "$data_dir/bitcoin/client-key.pem" ]; then grpc_status="gRPC certificates OK"; else grpc_status="gRPC disabled or certificates missing"; fi
		if [ -r "$data_dir/bitcoin/hsm_secret" ] && [ -r "$data_dir/bitcoin/emergency.recover" ]; then backup_status="backup files present"; elif [ -r "$data_dir/bitcoin/hsm_secret" ]; then backup_status="hsm_secret present; emergency.recover not present"; else backup_status="backup files not found"; fi
		if summary="$(printf '%s' "$info" | jq -er '. as $i | "RPC OK; node_id=" + ($i.id // "unknown") + "; alias=" + ($i.alias // "unknown") + "; network=" + ($i.network // "unknown") + "; version=" + ($i.version // "unknown")' 2>/dev/null)"; then
			echo "$summary; channels=$channels; onchain_outputs=$outputs; $bitcoin_status; $grpc_status; $backup_status"
		else
			echo "RPC OK; node details unavailable"
		fi
	else
		echo "RPC unavailable. The service may be stopped or Bitcoin Core may still be synchronizing."
	fi
}

ynh_app_config_run "$1"
