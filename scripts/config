#!/bin/bash

source "$(dirname "$0")/_common.sh"
source /usr/share/yunohost/helpers

ynh_abort_if_errors

get__alias() {
	ynh_cln_setting alias "My YunoHost Lightning Node"
}

set__alias() {
	ynh_app_setting_set --app="$app" --key=alias --value="$alias"
	ynh_cln_require_bitcoin_app
	ynh_cln_read_bitcoin_rpc_credentials
	ynh_cln_write_config
	ynh_cln_restart_and_check alias
}

get__p2p() {
	ynh_cln_p2p_port
}

set__p2p() {
	case "$p2p" in
		''|*[!0-9]*) ynh_die "Lightning P2P port must be numeric" ;;
	esac
	[ "$p2p" -ge 1 ] && [ "$p2p" -le 65535 ] || ynh_die "Lightning P2P port must be between 1 and 65535"
	ynh_app_setting_set --app="$app" --key=p2p --value="$p2p"
	ynh_cln_require_bitcoin_app
	ynh_cln_read_bitcoin_rpc_credentials
	ynh_cln_write_config
	ynh_cln_restart_and_check p2p
}

get__log_level() {
	ynh_cln_setting log_level info
}

set__log_level() {
	case "$log_level" in
		info|debug|io) ;;
		*) ynh_die "Unsupported Core Lightning log level: $log_level" ;;
	esac
	ynh_app_setting_set --app="$app" --key=log_level --value="$log_level"
	ynh_cln_require_bitcoin_app
	ynh_cln_read_bitcoin_rpc_credentials
	ynh_cln_write_config
	ynh_cln_restart_and_check log_level
}

get__announce_addr() { ynh_cln_setting announce_addr ''; }

set__announce_addr() {
	case "$announce_addr" in *[[:space:]]*) ynh_die "Announce address must not contain whitespace" ;; esac
	ynh_app_setting_set --app="$app" --key=announce_addr --value="$announce_addr"
	ynh_cln_require_bitcoin_app; ynh_cln_read_bitcoin_rpc_credentials; ynh_cln_write_config
	ynh_cln_restart_and_check announce_addr
}

get__rgb() { ynh_cln_setting rgb ''; }

set__rgb() {
	if [ -n "$rgb" ] && { [ "${#rgb}" -ne 6 ] || case "$rgb" in *[!0-9A-Fa-f]*) true ;; *) false ;; esac; }; then
		ynh_die "Node color must be exactly six hexadecimal characters"
	fi
	ynh_app_setting_set --app="$app" --key=rgb --value="$rgb"
	ynh_cln_require_bitcoin_app; ynh_cln_read_bitcoin_rpc_credentials; ynh_cln_write_config
	ynh_cln_restart_and_check rgb
}

get__fee_base() { ynh_cln_setting fee_base 1000; }
get__fee_per_sat() { ynh_cln_setting fee_per_sat 10; }
get__min_capacity_sat() { ynh_cln_setting min_capacity_sat 10000; }

set__fee_base() {
	case "$fee_base" in ''|*[!0-9]*) ynh_die "Base fee must be a non-negative integer" ;; esac
	ynh_app_setting_set --app="$app" --key=fee_base --value="$fee_base"
	ynh_cln_require_bitcoin_app; ynh_cln_read_bitcoin_rpc_credentials; ynh_cln_write_config
	ynh_cln_restart_and_check fee_base
}

set__fee_per_sat() {
	case "$fee_per_sat" in ''|*[!0-9]*) ynh_die "Proportional fee must be a non-negative integer" ;; esac
	ynh_app_setting_set --app="$app" --key=fee_per_sat --value="$fee_per_sat"
	ynh_cln_require_bitcoin_app; ynh_cln_read_bitcoin_rpc_credentials; ynh_cln_write_config
	ynh_cln_restart_and_check fee_per_sat
}

set__min_capacity_sat() {
	case "$min_capacity_sat" in ''|*[!0-9]*) ynh_die "Minimum channel capacity must be a non-negative integer" ;; esac
	ynh_app_setting_set --app="$app" --key=min_capacity_sat --value="$min_capacity_sat"
	ynh_cln_require_bitcoin_app; ynh_cln_read_bitcoin_rpc_credentials; ynh_cln_write_config
	ynh_cln_restart_and_check min_capacity_sat
}

run__show_recovery_mnemonic() {
	local hsmtool="$install_dir/bin/lightning-hsmtool" mnemonic
	local hsm_secret="$data_dir/bitcoin/hsm_secret"
	[ -x "$hsmtool" ] || hsmtool="$install_dir/tools/lightning-hsmtool"
	[ -x "$hsmtool" ] || ynh_die "Core Lightning's lightning-hsmtool is not installed. Repair or upgrade the package first."
	[ -r "$hsm_secret" ] || ynh_die "Core Lightning hsm_secret was not found at $hsm_secret. The node may not have completed first startup."
	if ! mnemonic="$("$hsmtool" getsecret "$hsm_secret" 2>/dev/null)" || [ -z "$mnemonic" ]; then
		ynh_die "Core Lightning could not export the recovery mnemonic. If this is an older node, use the legacy secret format documented in doc/BACKUP.md."
	fi
	# Config-panel actions must use YunoHost's print helpers: raw stdout from
	# the action is not reliably surfaced by the web-admin operation view.
	ynh_print_warn "The next output contains the wallet recovery mnemonic. Do not copy it into tickets, screenshots, shell history, or ordinary logs."
	ynh_print_warn "Anyone with this mnemonic may be able to steal funds. Record it offline, then clear this operation output."
	ynh_print_warn "Recovery mnemonic: $mnemonic"
}

get__grpc_enabled() {
	ynh_cln_setting grpc_enabled false
}

set__grpc_enabled() {
	# YunoHost's config-panel boolean type passes its own yes/no encoding
	# (1/0) to the setter, not the literal strings "true"/"false" - accept
	# both so this works whether called via the panel or directly.
	case "$grpc_enabled" in
		true|1) grpc_enabled=true ;;
		false|0) grpc_enabled=false ;;
		*) ynh_die "grpc_enabled must be true or false" ;;
	esac
	ynh_app_setting_set --app="$app" --key=grpc_enabled --value="$grpc_enabled"
	ynh_cln_require_bitcoin_app
	ynh_cln_read_bitcoin_rpc_credentials
	ynh_cln_write_config
	ynh_cln_restart_and_check grpc_enabled
}

get__grpc_port() {
	ynh_cln_grpc_port
}

set__grpc_port() {
	case "$grpc_port" in
		''|*[!0-9]*) ynh_die "gRPC port must be numeric" ;;
	esac
	[ "$grpc_port" -ge 1 ] && [ "$grpc_port" -le 65535 ] || ynh_die "gRPC port must be between 1 and 65535"
	ynh_app_setting_set --app="$app" --key=grpc_port --value="$grpc_port"
	ynh_cln_require_bitcoin_app
	ynh_cln_read_bitcoin_rpc_credentials
	ynh_cln_write_config
	ynh_cln_restart_and_check grpc_port
}

get__status() {
	local info summary channels outputs bitcoin_status grpc_status backup_status candidate found=""
	# This is a read-only display value.  Nothing in it may abort the whole
	# config-panel read when the node or Bitcoin backend is temporarily
	# unavailable.
	if ynh_cln_healthcheck >/dev/null 2>&1; then
		info="$(ynh_cln_rpc getinfo 2>/dev/null || true)"
		channels="$(ynh_cln_rpc listfunds 2>/dev/null | jq -r '.channels | length' 2>/dev/null || echo '?')"
		outputs="$(ynh_cln_rpc listfunds 2>/dev/null | jq -r '.outputs | length' 2>/dev/null || echo '?')"
		if [ -n "$bitcoin_install_dir" ]; then
			for candidate in "$bitcoin_install_dir"/bitcoin-*/bin/bitcoin-cli; do
				[ -x "$candidate" ] || continue
				if [ -n "$found" ]; then found=""; break; fi
				found="$candidate"
			done
		fi
		if [ -n "$found" ] && runuser -u "$app" -- "$found" -conf="$bitcoin_config_file" -datadir="$bitcoin_data_dir" getblockchaininfo >/dev/null 2>&1; then bitcoin_status="Bitcoin RPC OK"; else bitcoin_status="Bitcoin RPC unavailable"; fi
		if [ "$(ynh_cln_setting grpc_enabled false)" = "true" ] && [ -r "$data_dir/bitcoin/ca.pem" ] && [ -r "$data_dir/bitcoin/client.pem" ] && [ -r "$data_dir/bitcoin/client-key.pem" ]; then grpc_status="gRPC certificates OK"; else grpc_status="gRPC disabled or certificates missing"; fi
		if [ -r "$data_dir/bitcoin/hsm_secret" ] && [ -r "$data_dir/bitcoin/emergency.recover" ]; then backup_status="backup files present"; elif [ -r "$data_dir/bitcoin/hsm_secret" ]; then backup_status="hsm_secret present; emergency.recover not present"; else backup_status="backup files not found"; fi
		if summary="$(printf '%s' "$info" | jq -er '. as $i | "RPC OK; node_id=" + ($i.id // "unknown") + "; alias=" + ($i.alias // "unknown") + "; network=" + ($i.network // "unknown") + "; version=" + ($i.version // "unknown")' 2>/dev/null)"; then
			echo "$summary; channels=$channels; onchain_outputs=$outputs; $bitcoin_status; $grpc_status; $backup_status"
		else
			echo "RPC OK; node details unavailable"
		fi
	else
		echo "RPC unavailable. The service may be stopped or Bitcoin Core may still be synchronizing."
	fi
}

ynh_app_config_run "$1"
