#!/bin/bash
set -eu
source /usr/share/yunohost/helpers
source "$(dirname "$0")/_common.sh"

ynh_script_progression "Checking Bitcoin Core backend..."
ynh_cln_require_bitcoin_app
ynh_cln_read_bitcoin_rpc_credentials

ynh_script_progression "Stopping Core Lightning for a safe upgrade..."
ynh_systemctl --service="$service_name" --action=stop --timeout=300
ynh_print_info "The package must be backed up before replacing binaries; database downgrade is not attempted."
ynh_setup_source --source_id=main --dest_dir="$install_dir"
ynh_cln_unpack
ynh_cln_check_runtime_access
ynh_cln_write_config
yunohost service add "$service_name" --description="Core Lightning node" --log=systemd || true
ynh_config_add_systemd
ynh_systemctl --service="$service_name" --action=start --log_path=systemd --timeout=60
if ! ynh_cln_wait_for_rpc 300; then
	ynh_cln_dump_diagnostics
	ynh_die "Core Lightning RPC health check failed after upgrade"
fi
ynh_cln_check_bitcoin_rpc
ynh_cln_fix_grpc_cert_perms

ynh_script_progression "Updating Core Lightning web interface..."
yunohost service add "$web_service_name" --description="Core Lightning web interface" --log=systemd || true
ynh_cln_install_web_assets
ynh_cln_configure_web_service
ynh_add_nginx_config
ynh_systemctl --service="$web_service_name" --action=restart --log_path=systemd --timeout=60
