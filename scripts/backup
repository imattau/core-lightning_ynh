#!/bin/bash
set -eu
source /usr/share/yunohost/helpers
source "$(dirname "$0")/_common.sh"

ynh_script_progression "Stopping Core Lightning before backup..."
was_active=0
systemctl is-active --quiet "$service_name" && was_active=1 || true
if [ "$was_active" -eq 1 ]; then
	ynh_systemctl --service="$service_name" --action=stop --timeout=300
fi

ynh_backup "$config_dir"
ynh_backup "$data_dir"
ynh_backup "/etc/systemd/system/$service_name.service"

if [ "$was_active" -eq 1 ]; then
	ynh_systemctl --service="$service_name" --action=start --log_path=systemd --timeout=60
fi
ynh_print_info "This backup contains hsm_secret, channel state, and emergency.recover when present. It is not a guarantee of Lightning fund recovery; keep a separate secure key backup."
