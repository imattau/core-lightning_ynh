#!/bin/bash
set -eu
source /usr/share/yunohost/helpers
source "$(dirname "$0")/_common.sh"

if systemctl is-active --quiet "$service_name"; then
	funds="$(ynh_cln_rpc listfunds 2>/dev/null || true)"
	if printf '%s\n' "$funds" | grep -q '"amount_msat"' && [ "${YNH_FORCE_REMOVAL:-0}" != "1" ]; then
		ynh_die "Core Lightning reports wallet, channel, or other Lightning funds. Removing this app may destroy keys and channel state containing funds. Sweep or close channels and make secure backups before removal."
	fi
fi

ynh_config_remove_nginx

ynh_script_progression "Stopping Core Lightning web interface..."
ynh_systemctl --service="$web_service_name" --action=stop || true
yunohost service remove "$web_service_name" || true
systemctl disable "$web_service_name.service" >/dev/null 2>&1 || true
ynh_safe_rm "/etc/systemd/system/$web_service_name.service"
systemctl daemon-reload

ynh_script_progression "Stopping Core Lightning..."
ynh_systemctl --service="$service_name" --action=stop --timeout=300 || true
yunohost service remove "$service_name" || true
systemctl disable "$service_name.service" >/dev/null 2>&1 || true
ynh_safe_rm "/etc/systemd/system/$service_name.service"
systemctl daemon-reload
ynh_safe_rm "$config_dir"
ynh_safe_rm "$install_dir"
ynh_safe_rm "$data_dir"
