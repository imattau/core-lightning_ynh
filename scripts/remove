#!/bin/bash
set -eu
source /usr/share/yunohost/helpers
source "$(dirname "$0")/_common.sh"

if systemctl is-active --quiet "$service_name"; then
	channels="$(ynh_cln_rpc listchannels 2>/dev/null | grep -c '"source"' || true)"
	if [ "$channels" -gt 0 ] && [ "${YNH_FORCE_REMOVAL:-0}" != "1" ]; then
		ynh_die "Core Lightning reports open channel state. Removing this app may destroy keys and channel state containing funds. Close channels and retry, or set YNH_FORCE_REMOVAL=1 only after making secure backups."
	fi
fi

ynh_script_progression "Stopping Core Lightning..."
ynh_systemctl --service="$service_name" --action=stop --timeout=300 || true
yunohost service remove "$service_name" || true
ynh_config_rm
ynh_secure_remove "$config_dir"
ynh_secure_remove "$install_dir"
ynh_secure_remove "$data_dir"
