#!/bin/bash
set -eu
source /usr/share/yunohost/helpers
source "$(dirname "$0")/_common.sh"

ynh_script_progression "Checking Bitcoin Core backend..."
ynh_cln_require_bitcoin_app
ynh_cln_read_bitcoin_rpc_credentials

# The release binary is deliberately excluded from backups (not part of
# $config_dir/$data_dir), so it must be fetched and unpacked fresh here,
# exactly as on a first install, before the service can start.
ynh_script_progression "Reinstalling Core Lightning binaries..."
ynh_setup_source --source_id=main --dest_dir="$install_dir"
ynh_cln_unpack
ynh_cln_check_runtime_access

ynh_script_progression "Restoring Core Lightning state..."
ynh_systemctl --service="$service_name" --action=stop --timeout=300 || true
mkdir -p "$config_dir" "$data_dir"
ynh_restore "$config_dir"
ynh_restore "$data_dir"
ynh_restore "/etc/systemd/system/$service_name.service"
# ynh_restore doesn't guarantee the exact ownership/mode ynh_cln_write_config
# originally set - lightningd (running as $app) must be able to read its own
# config, so reassert it explicitly rather than trusting the restore verbatim.
# This includes $config_dir itself: it was observed restored as root:root
# 0400 (no execute/search bit at all), which blocks opening *any* file
# inside it regardless of that file's own permissions - confirmed live via
# `Opening and reading .../lightningd.conf: Permission denied` even though
# the file itself was already correctly root:$app 0640.
chmod 0755 "$config_dir"
chown root:"$app" "$config_file"
chmod 0640 "$config_file"
chown -R "$app:$app" "$data_dir"
chmod 0700 "$data_dir" "$data_dir/bitcoin"
yunohost service add "$service_name" --description="Core Lightning node" --log=systemd || true
ynh_config_add_systemd
ynh_systemctl --service="$service_name" --action=start --log_path=systemd --timeout=60
if ! ynh_cln_wait_for_rpc 300; then
	ynh_cln_dump_diagnostics
	ynh_die "Core Lightning RPC did not become available after restore"
fi
ynh_cln_check_bitcoin_rpc
ynh_cln_fix_grpc_cert_perms
